<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F9FAFB"
    android:gravity="center_vertical"> <!-- Centrado verticalmente -->

    <!-- Título centrado -->
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tittle"
        android:textColor="#2563EB"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Versión centrado -->
    <TextView
        android:id="@+id/version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/version"
        android:textColor="#111"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <!-- Label y Campo de IP centrado -->
    <TextView
        android:id="@+id/labelIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hover_ip_base"
        android:textColor="#2563EB"
        android:textSize="16sp"
        android:layout_marginBottom="4dp"
        android:gravity="start" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/ipInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#2563EB"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ipInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hover_ip_base"
            android:inputType="text"
            android:textColor="#111"
            android:textSize="16sp"
            android:background="@drawable/input_background" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Label y Campo de Máscara centrado -->
    <TextView
        android:id="@+id/labelMask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hover_mascara_ini"
        android:textColor="#2563EB"
        android:textSize="16sp"
        android:layout_marginBottom="4dp"
        android:gravity="start" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/maskInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#2563EB"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/maskInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hover_mascara_ini"
            android:inputType="number"
            android:textColor="#111"
            android:textSize="16sp"
            android:background="@drawable/input_background" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Label y Campo de Subredes centrado -->
    <TextView
        android:id="@+id/labelNumSubnets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hover_num_sr"
        android:textColor="#2563EB"
        android:textSize="16sp"
        android:layout_marginBottom="4dp"
        android:gravity="start" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/numSubnetsInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#2563EB"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/numSubnetsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hover_num_sr"
            android:inputType="number"
            android:textColor="#111"
            android:textSize="16sp"
            android:background="@drawable/input_background" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botón de Generar -->
    <Button
        android:id="@+id/generateFieldsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/generar"
        android:textColor="#FFF"
        android:backgroundTint="#2563EB"
        android:layout_marginBottom="16dp" />

    <!-- Contenedor de hosts centrado -->
    <LinearLayout
        android:id="@+id/hostsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical" />

    <!-- Botón de volver al paso 1 -->
    <Button
        android:id="@+id/backToStepOneButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_return"
        android:layout_marginTop="8dp"
        android:textColor="#FFF"
        android:backgroundTint="#EF4444"
        android:visibility="gone" />

    <!-- Botón de Calcular -->
    <Button
        android:id="@+id/calculateButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/calcular"
        android:layout_marginTop="16dp"
        android:textColor="#FFF"
        android:backgroundTint="#2563EB" />

    <!-- ScrollView para resultados -->
    <ScrollView
        android:id="@+id/resultsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/resultOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:padding="16dp"
                android:textColor="#111"
                android:background="@drawable/output_background" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/newCalculationButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/new_cal"
        android:layout_marginTop="16dp"
        android:textColor="#FFF"
        android:backgroundTint="#10B981"
        android:visibility="gone" />

</LinearLayout>

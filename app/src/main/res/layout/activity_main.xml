<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <EditText
                android:id="@+id/ipInput"
                android:hint="Dirección IP (ej: 192.168.1.0)"
                android:inputType="text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background"
                android:padding="14dp"
                android:textColor="#000"
                android:textColorHint="#888"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/maskInput"
                android:hint="Máscara (ej: 24)"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background"
                android:padding="14dp"
                android:textColor="#000"
                android:textColorHint="#888"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/subnetCountInput"
                android:hint="Cantidad de subredes"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background"
                android:padding="14dp"
                android:textColor="#000"
                android:textColorHint="#888"
                android:textSize="16sp"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/calculateButton"
                android:text="Calcular Subredes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#2563EB"
                android:textColor="#FFF"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:padding="14dp"
                android:layout_marginBottom="24dp"
                android:elevation="2dp"/>

            <TextView
                android:id="@+id/resultOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#111"
                android:background="@drawable/output_background"
                android:padding="16dp"
                android:lineSpacingExtra="4dp"
                android:scrollbars="vertical"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
